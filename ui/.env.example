# Copy to .env.local for local development. Only VITE_-prefixed vars are exposed
# to the client — never put secrets here.

# Base URL for API calls. Leave empty in dev so the Vite proxy handles /api.
# In production, point at the backend origin (the fetch wrapper appends /api).
VITE_API_URL=

# Where the dev proxy forwards /api requests (the /api prefix is stripped).
VITE_PROXY_TARGET=http://localhost:8000

# Set to "true" (dev only) to use the in-memory test auth provider.
VITE_TEST_AUTH=false
