# Rendered to .env by scripts/generate-env.sh. All settings use the APP_ prefix.
#
# Non-secret defaults are hardcoded and target HOST-side tooling (localhost), so
# `uv run ...` works directly. Inside containers, docker-compose overrides the
# hostnames (db, localstack) via each service's `environment:` block.
#
# Secret / per-user values use the {{PLACEHOLDER}} convention: generate-env.sh
# substitutes each {{VAR}} from the same-named shell env var, and warns (never
# fails) on anything missing. This skeleton has no *required* secrets, so the only
# placeholders below ship commented out as living documentation.

APP_ENVIRONMENT=development

# --- Database ---
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app
# APP_DATABASE_POOL_SIZE=5
# APP_DATABASE_MAX_OVERFLOW=10
# APP_DATABASE_POOL_RECYCLE_SECONDS=1800
# APP_DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- SQS / AWS (LocalStack) ---
APP_AWS_ENDPOINT_URL=http://localhost:4566
APP_AWS_REGION=us-east-1
APP_SQS_QUEUE_URL=http://localhost:4566/000000000000/app-jobs
APP_SQS_DLQ_URL=http://localhost:4566/000000000000/app-jobs-dlq
# Dummy creds satisfy boto3 against LocalStack.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Worker ---
# APP_WORKER_CONCURRENCY=5
# APP_WORKER_POLL_WAIT_SECONDS=20
# APP_WORKER_VISIBILITY_TIMEOUT_SECONDS=300
# APP_WORKER_MAX_JOB_DEPTH=25

# --- Pagination ---
# APP_PAGINATION_DEFAULT_LIMIT=50
# APP_PAGINATION_MAX_LIMIT=500

# --- Optional integrations (example of the {{PLACEHOLDER}} convention) ---
# Uncomment and export the matching shell var before running generate-env.sh:
# APP_SOME_API_KEY={{SOME_API_KEY}}
